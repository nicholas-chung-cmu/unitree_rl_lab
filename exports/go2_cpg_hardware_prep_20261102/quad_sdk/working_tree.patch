+"""Explicit opt-in Go2 CPG hardware launch. Does not arm or request standing."""
+import json
+from pathlib import Path
+import sys
+import tempfile
+import subprocess
+import os
+from launch import LaunchDescription
+from launch.actions import DeclareLaunchArgument,ExecuteProcess,IncludeLaunchDescription,OpaqueFunction
+from launch.launch_description_sources import PythonLaunchDescriptionSource
+from launch.substitutions import LaunchConfiguration
+from ament_index_python.packages import get_package_share_directory
+import yaml
+
+
+def start(context):
+    root=Path(LaunchConfiguration('conga_root').perform(context)).expanduser().resolve()
+    profile_path=Path(LaunchConfiguration('profile').perform(context)).expanduser().resolve()
+    selection=Path(LaunchConfiguration('selection').perform(context)).expanduser().resolve()
+    if LaunchConfiguration('activate_hardware').perform(context).lower()!='true':
+        raise RuntimeError('Hardware launch requires activate_hardware:=true. For read-only shadow use cpg_quad_hardware.py without --active.')
+    sys.path.insert(0,str(root/'scripts'))
+    from cpg_quad_hardware import validate_profile
+    profile=json.loads(profile_path.read_text());sel=json.loads(selection.read_text());validate_profile(profile,sel,True)
+    # Gate all checks BEFORE creating any driver (its vendor interface releases sport mode).
+    from hashlib import sha256
+    actor=Path(sel['onnx_export']);actor=actor if actor.is_absolute() else selection.parent/actor
+    if sha256(actor.read_bytes()).hexdigest()!=sel['onnx_sha256']:raise ValueError('Policy checksum mismatch')
+    policy_python=LaunchConfiguration('policy_python').perform(context)
+    trace=Path(LaunchConfiguration('trace').perform(context)).expanduser().resolve()
+    if trace.exists():raise ValueError('Trace exists; use a fresh path')
+    trace.parent.mkdir(parents=True,exist_ok=True)
+    # Prove that ROS imports, the custom message, policy dependencies and worker
+    # handshake work BEFORE starting the vendor interface / releasing Sport.
+    subprocess.run(['/usr/bin/python3','-c',
+        'import rclpy; from quad_msgs.msg import CpgSensorFrame; from geometry_msgs.msg import Twist'],check=True,timeout=15)
+    with tempfile.TemporaryDirectory(prefix='cpg_preflight_') as tmp:
+        subprocess.run(['/usr/bin/python3',str(root/'scripts/cpg_preflight.py'),
+            '--selection',str(selection),'--policy-python',policy_python,
+            '--output',str(Path(tmp)/'preflight.json')],check=True,timeout=55)
+    with tempfile.NamedTemporaryFile(dir=trace.parent,prefix='.cpg_trace_probe_'):
+        pass
+    ns=LaunchConfiguration('namespace').perform(context).strip('/')
+    if not ns or '/' in ns:raise ValueError('Use a single robot namespace, e.g. robot_1')
+    with tempfile.NamedTemporaryFile(mode='w',prefix='cpg_hardware_',suffix='.yaml',delete=False) as f:
+        yaml.safe_dump({'/**/robot_driver':{'ros__parameters':{'cpg.hardware_enabled':True,'cpg.contact_calibrated':True,'cpg.timing_verified':True}}},f)
+        params=f.name
+    return [
+        ExecuteProcess(cmd=['/usr/bin/python3','-u',str(root/'scripts/cpg_quad_hardware.py'),'--selection',str(selection),'--profile',str(profile_path),'--policy-python',policy_python,'--robot-ns','/'+ns,'--trace',str(trace),'--active'],output='screen'),
+        IncludeLaunchDescription(PythonLaunchDescriptionSource(str(Path(get_package_share_directory('quad_utils'))/'launch/robot_driver.py')),
+            launch_arguments={'robot_type':'go2','controller':'cpg','is_hardware':'true','mocap':'false','use_sim_time':'false','namespace':ns,'extra_params':params}.items())]
+
+
+def generate_launch_description():
+    return LaunchDescription([
+        DeclareLaunchArgument('conga_root'),DeclareLaunchArgument('selection'),DeclareLaunchArgument('profile'),
+        DeclareLaunchArgument('policy_python'),DeclareLaunchArgument('activate_hardware',default_value='false'),
+        DeclareLaunchArgument('namespace',default_value='robot_1'),DeclareLaunchArgument('trace',default_value='/tmp/cpg_hardware_trace.jsonl'),
+        OpaqueFunction(function=start)])
diff --git a/robot_driver/include/robot_driver/controllers/cpg_command_guard.hpp b/robot_driver/include/robot_driver/controllers/cpg_command_guard.hpp
new file mode 100644
index 00000000..4b02fc28
--- /dev/null
+++ b/robot_driver/include/robot_driver/controllers/cpg_command_guard.hpp
@@ -0,0 +1,39 @@
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <stdexcept>
+
+namespace cpg_guard {
+// Sample-based bound on PD + feedforward. This changes transmitted gains/torque,
+// not just telemetry. It is NOT a guarantee of physical torque between samples.
+struct Motor { double q, dq, kp, kd, ff; };
+inline double effort(const Motor& m, double q, double dq) {
+  return m.kp*(m.q-q)+m.kd*(m.dq-dq)+m.ff;
+}
+inline bool finite(const Motor& m) {
+  return std::isfinite(m.q)&&std::isfinite(m.dq)&&std::isfinite(m.kp)&&
+         std::isfinite(m.kd)&&std::isfinite(m.ff)&&m.kp>=0&&m.kd>=0;
+}
+inline double limit(Motor& m, double q, double dq, double cap=18.) {
+  if (!finite(m)||!std::isfinite(q)||!std::isfinite(dq)||!std::isfinite(cap)||cap<=0)
+    throw std::invalid_argument("nonfinite CPG motor/state or invalid limit");
+  const double raw=effort(m,q,dq);
+  const double envelope=(raw*dq>=0 ? 20.2 : 23.4)*
+      std::clamp((30.-std::abs(dq))/(30.-13.5),0.,1.);
+  const double bound=std::min(cap,envelope);
+  // Scale all gains and feedforward together to avoid cancellation artefacts.
+  const double scale=std::abs(raw)>bound ? bound/std::abs(raw) : 1.;
+  m.kp*=scale;m.kd*=scale;m.ff*=scale;
+  return scale;
+}
+inline bool targetRange(double q,int joint) {
+  // Conservative subset of Go2 URDF bounds; calf stays on negative-knee branch.
+  constexpr double lo[3]={-.95,-1.32,-2.63}, hi[3]={.95,3.24,-.93};
+  return std::isfinite(q)&&q>=lo[joint]&&q<=hi[joint];
+}
+inline bool measuredRange(double q,double dq,int joint) {
+  constexpr double lo[3]={-1.20,-1.73,-2.88},hi[3]={1.20,3.65,-.68};
+  constexpr double speed[3]={35.,35.,18.};
+  return std::isfinite(q)&&std::isfinite(dq)&&q>=lo[joint]&&q<=hi[joint]&&std::abs(dq)<=speed[joint];
+}
+} // namespace cpg_guard
diff --git a/robot_driver/include/robot_driver/controllers/cpg_controller.hpp b/robot_driver/include/robot_driver/controllers/cpg_controller.hpp
new file mode 100644
index 00000000..81f30e2d
--- /dev/null
+++ b/robot_driver/include/robot_driver/controllers/cpg_controller.hpp
@@ -0,0 +1,92 @@
+#pragma once
+#include "robot_driver/controllers/leg_controller.hpp"
+#include "robot_driver/controllers/cpg_command_guard.hpp"
+#include <std_msgs/msg/string.hpp>
+#include <chrono>
+#include <stdexcept>
+
+// Complete CPG runtime command sink. Hardware is opt-in and requires calibration
+// attestations. The driver remains the sole joint-command publisher.
+class CpgController : public LegController {
+ public:
+  CpgController(rclcpp::Node::SharedPtr node, const std::string& ns,
+                std::shared_ptr<quad_utils::QuadKD2> kd)
+      : LegController(node, ns, kd) {
+    node_->get_parameter("is_hardware", hardware_);
+    bool enabled=false, calibrated=false, timing=false;
+    quad_utils::loadROSParamDefault(node_,"cpg.hardware_enabled",enabled,false);
+    quad_utils::loadROSParamDefault(node_,"cpg.contact_calibrated",calibrated,false);
+    quad_utils::loadROSParamDefault(node_,"cpg.timing_verified",timing,false);
+    if (hardware_ && !(enabled&&calibrated&&timing))
+      throw std::runtime_error("CPG hardware requires explicit enable, measured contacts and verified timing");
+    fault_pub_=node_->create_publisher<std_msgs::msg::String>("cpg/fault",1);
+    fault_sub_=node_->create_subscription<std_msgs::msg::String>("cpg/fault",1,
+        [this](std_msgs::msg::String::SharedPtr msg){ fail(msg->data.c_str()); });
+    sub_ = node_->create_subscription<quad_msgs::msg::LegCommandArray>(
+        "cpg/target", 1, [this](quad_msgs::msg::LegCommandArray::SharedPtr msg) {
+          if (fault_) return;
+          if (msg->leg_commands.size()!=4) {fail("invalid leg count");return;}
+          const double stamp=rclcpp::Time(msg->header.stamp).seconds();
+          const double age=node_->now().seconds()-stamp;
+          if (age<-.01 || age>.06 || (received_&&stamp<=last_stamp_)) {
+            fail("stale, duplicate or regressing target timestamp");return;
+          }
+          for (const auto& leg:msg->leg_commands) {
+            if (leg.motor_commands.size()!=3) {fail("invalid motor count");return;}
+            for (int j=0;j<3;++j) {
+              const auto& m=leg.motor_commands[j];
+              if (!cpg_guard::targetRange(m.pos_setpoint,j)||m.kp!=25.||m.kd!=.5||
+                  m.torque_ff!=0.||m.vel_setpoint!=0.) {fail("invalid target/gains");return;}
+            }
+          }
+          latest_=*msg;received_=true;last_stamp_=stamp;
+          last_wall_=std::chrono::steady_clock::now();
+        });
+  }
+  bool computeLegCommandArray(const quad_msgs::msg::RobotState& state,
+      quad_msgs::msg::LegCommandArray& output, quad_msgs::msg::GRFArray&) override {
+    if (received_ && (node_->now().seconds()-last_stamp_>.06 ||
+        (hardware_&&std::chrono::duration<double>(std::chrono::steady_clock::now()-last_wall_).count()>.06)))
+      fail("target stream stopped");
+    if (fault_) {
+      // No abrupt position jump to standing while a foot may be raised. Damping
+      // is a harness-test emergency response, NOT a guaranteed upright recovery.
+      output.leg_commands.resize(4);
+      for(auto& leg:output.leg_commands) {
+        leg.motor_commands.resize(3);
+        for(auto& m:leg.motor_commands) {m.pos_setpoint=0;m.vel_setpoint=0;m.kp=0;m.kd=.5;m.torque_ff=0;}
+      }
+      return true;
+    }
+    if (!received_) return false; // driver standing posture before first target
+    output=latest_;
+    if(state.joints.position.size()!=12||state.joints.velocity.size()!=12) {
+      fail("missing joint state");return computeLegCommandArray(state,output,unused_);
+    }
+    for(int leg=0;leg<4;++leg) for(int j=0;j<3;++j) {
+      auto& m=output.leg_commands[leg].motor_commands[j];int idx=3*leg+j;
+      cpg_guard::Motor cmd{m.pos_setpoint,m.vel_setpoint,m.kp,m.kd,m.torque_ff};
+      try { cpg_guard::limit(cmd,state.joints.position[idx],state.joints.velocity[idx]); }
+      catch(const std::exception& e) { fail(e.what());return computeLegCommandArray(state,output,unused_); }
+      m.kp=cmd.kp;m.kd=cmd.kd;m.torque_ff=cmd.ff;
+    }
+    return true;
+  }
+  void latchFault(const char* reason) { fail(reason); }
+  bool faulted() const { return fault_; }
+ private:
+  void fail(const char* reason) {
+    if(fault_) return;
+    fault_=true;
+    std_msgs::msg::String msg;msg.data=reason;fault_pub_->publish(msg);
+    RCLCPP_ERROR(node_->get_logger(),"CPG fault latched: %s; damping only; restart required",reason);
+  }
+  bool hardware_=true,received_=false,fault_=false;
+  double last_stamp_=0.;
+  std::chrono::steady_clock::time_point last_wall_;
+  quad_msgs::msg::GRFArray unused_;
+  quad_msgs::msg::LegCommandArray latest_;
+  rclcpp::Subscription<quad_msgs::msg::LegCommandArray>::SharedPtr sub_;
+  rclcpp::Subscription<std_msgs::msg::String>::SharedPtr fault_sub_;
+  rclcpp::Publisher<std_msgs::msg::String>::SharedPtr fault_pub_;
+};
